.venv/

# Vendor datasheets and reference PDFs — fetch from the source, don't commit
docs/*.pdf

# GH3 cover art working dir: track the original downloads (the stable, non-deterministic-
# to-refetch inputs to process_gh3_cover_art.py), ignore the regenerable resized output.
tools/gh3-cover-art/data/*
!tools/gh3-cover-art/data/*.jpg

# QR tiles dumped by verify.py --png: regenerable from the NODE table's URLs, for
# eyeballing only. The verification itself needs no stored artifact.
tools/qr-verify/data/

# Sample-point overlays from render_cv_points.py: regenerable from the corpus
# frame plus cv_marvin_v1.c, for eyeballing calibration only.
tools/gameplay/data/cv_points/
