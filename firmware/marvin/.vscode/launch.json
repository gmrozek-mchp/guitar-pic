{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "cwd": "${workspaceRoot}",
            "gdbPath": "/Applications/ArmGNUToolchain/15.2.rel1/arm-none-eabi/bin/arm-none-eabi-gdb",
            "executable": "${workspaceFolder}/out/${workspaceFolderBasename}/default.elf",
            "name": "Debug with OpenOCD",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "openocd",
            "gdbTarget": "localhost:50000",
            "serverpath": "/opt/homebrew/bin/openocd",
            "serverArgs": [],
            "openOCDLaunchCommands":[],
            "configFiles": ["${workspaceFolder}/sam9x75.cfg"],
            "searchDir": [],
            "showDevDebugOutput": "none",
            "breakAfterReset": true,
            "postResetCommands": [
                 "monitor reset init",
                "load  ./binaries/sam9x7-boot-none-4.0.13.elf",
                "monitor reg pc 0x300000",
                "monitor arm9.0 arm core_state arm",
                "monitor resume",
                "monitor sleep 500",
                "monitor halt",
                "load"
            ],
            "preLaunchCommands": [
                "monitor arm9.0 curstate"
            ],
            "overrideLaunchCommands": [
                "monitor reset init",
                "load  ./binaries/sam9x7-boot-none-4.0.13.elf",
                "monitor reg pc 0x300000",
                "monitor arm9.0 arm core_state arm",
                "monitor resume",
                "monitor sleep 500",
                "monitor halt",
                "load"
            ],
            "runToMain": false
        }
    ]
}