# Bluetooth Classic only — the Wiimote link is BR/EDR HID, not BLE.
# Option names target ESP-IDF v6.x; adjust if the menuconfig tree differs.
CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=n
CONFIG_BTDM_CTRL_MODE_BTDM=n

CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_BLE_ENABLED=n

# HID device profile (Bluedroid BT-Classic HID device).
CONFIG_BT_HID_ENABLED=y
CONFIG_BT_HID_DEVICE_ENABLED=y
CONFIG_BT_HID_HOST_ENABLED=n

# Legacy PIN pairing — a real Wiimote does not use Secure Simple Pairing; the Wii
# bonds with PIN = host BD_ADDR reversed. Disabling SSP forces the legacy path.
CONFIG_BT_SSP_ENABLED=n

# Raw L2CAP, used to serve the HID control/interrupt PSMs (0x11/0x13) ourselves.
CONFIG_BT_L2CAP_ENABLED=y

# The Wiimote SDP record (~463 B; HID descriptor attribute ~225 B) exceeds the
# default 300-byte SDP buffers — raise them so the record can be registered.
CONFIG_BT_SDP_ATTR_LEN=512
CONFIG_BT_SDP_PAD_LEN=1024

# Adafruit Feather V2 has 8 MB flash (boot log warned the 2 MB default header).
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"

# Verbose Bluedroid logs — kept on while building out HIDP (Phase 2); trim later.
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y
CONFIG_BT_LOG_BTM_TRACE_LEVEL_DEBUG=y
CONFIG_BT_LOG_L2CAP_TRACE_LEVEL_DEBUG=y
CONFIG_BT_LOG_SDP_TRACE_LEVEL_DEBUG=y
CONFIG_BT_LOG_GAP_TRACE_LEVEL_DEBUG=y
CONFIG_BT_LOG_APPL_TRACE_LEVEL_DEBUG=y
