{
    "version": "1.9",
    "configurations": [
        {
            "name": "default",
            "id": "conf1",
            "device": "PIC32CM6408PL10048",
            "imagePath": "./out/fretboard/default.elf",
            "tool": "PKOB nano",
            "packs": [
                {
                    "name": "PIC32CM-PL_DFP",
                    "vendor": "Microchip",
                    "version": "1.4.418"
                },
                {
                    "name": "CMSIS",
                    "vendor": "ARM",
                    "version": "6.3.0"
                }
            ],
            "fileSet": "default",
            "toolchain": "default-XC32"
        }
    ],
    "propertyGroups": [
        {
            "name": "default-XC32",
            "type": "toolchain",
            "provider": "microchip.toolchains:xc32@5.10",
            "properties": {
                "compiler.extra-include-directories": [
                    ".",
                    "../../third_party/oa-tc6-lib/libtc6/inc",
                    "../../third_party/oa-tc6-lib/libtc6/src",
                    "config.mcc/src",
                    "config.mcc/src/config/default",
                    "config.mcc/src/packs/CMSIS",
                    "config.mcc/src/packs/CMSIS/CMSIS/Core/Include",
                    "config.mcc/src/packs/PIC32CM6408PL10048_DFP",
                    "third_party/embedded-cli"
                ],
                "compiler.optimization-level": "-O1",
                "linker.heap-size": "512",
                "compiler++.extra-include-directories": [
                    "config.mcc/src",
                    "config.mcc/src/config/default",
                    "config.mcc/src/packs/CMSIS",
                    "config.mcc/src/packs/CMSIS/CMSIS/Core/Include",
                    "config.mcc/src/packs/PIC32CM6408PL10048_DFP"
                ],
                "linker.no-device-startup-code": "true",
                "compiler.isolate-each-function": "true",
                "compiler.place-data-into-section": "true",
                "linker.remove-unused-sections": "true",
                "compiler++.isolate-each-function": "true",
                "compiler++.optimization-level": "-O1"
            }
        }
    ],
    "fileSets": [
        {
            "name": "default",
            "files": [
                "main.c",
                "cli.c",
                "cli.h",
                "fret_scan.c",
                "fret_scan.h",
                "data_stream.c",
                "data_stream.h",
                "model_infer.c",
                "model_infer.h",
                "model_infer_stream.c",
                "model_infer_stream.h",
                "model_weights.h",
                "models.h",
                "t1s_detector.c",
                "t1s_detector.h",
                "status_led.c",
                "status_led.h",
                "tc6-conf.h",
                "third_party/embedded-cli/embedded_cli.h",
                "third_party/embedded-cli/embedded_cli.c",
                "../../third_party/oa-tc6-lib/libtc6/src/tc6.c",
                "../../third_party/oa-tc6-lib/libtc6/src/tc6-regs.c",
                "config.mcc/src/config/default/peripheral/sercom/usart/plib_sercom1_usart.c",
                "config.mcc/src/config/default/peripheral/evsys/plib_evsys.c",
                "config.mcc/src/config/default/peripheral/sercom/spi_master/plib_sercom0_spi_master.c",
                "config.mcc/src/config/default/peripheral/adc/plib_adc0.c",
                "config.mcc/src/config/default/initialization.c",
                "config.mcc/src/config/default/interrupts.c",
                "config.mcc/src/config/default/exceptions.c",
                "config.mcc/src/config/default/PIC32CM6408PL10048.ld",
                "config.mcc/src/config/default/stdio/xc32_monitor.c",
                "config.mcc/src/config/default/peripheral/port/plib_port.c",
                "config.mcc/src/config/default/peripheral/clock/plib_clock.c",
                "config.mcc/src/config/default/peripheral/nvic/plib_nvic.c",
                "config.mcc/src/config/default/peripheral/systick/plib_systick.c",
                "config.mcc/src/config/default/startup_xc32.c",
                "config.mcc/src/config/default/libc_syscalls.c",
                "config.mcc/src/config/default/peripheral/eic/plib_eic.c",
                "config.mcc/src/config/default/peripheral/tc/plib_tc0.c"
            ]
        }
    ]
}
